generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("FARMER")
  phone        String?
  farmId       String?
  farm         Farm?    @relation("ActiveFarm", fields: [farmId], references: [id])
  ownedFarm    Farm?    @relation("Ownership")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Farm {
  id            String   @id @default(cuid())
  name          String
  location      String?
  sizeHectares  Float?
  capacity      Int?
  members       User[]   @relation("ActiveFarm")
  ownerId       String   @unique
  owner         User     @relation("Ownership", fields: [ownerId], references: [id], onDelete: Cascade)
  cattle        Cattle[]
  inventoryItems InventoryItem[]
  alerts        Alert[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Cattle {
  id              String    @id @default(cuid())
  tagNumber       String    @unique
  name            String?
  breed           String?
  gender          String
  birthDate       DateTime?
  weightKg        Float?
  healthStatus    String    @default("HEALTHY")
  pregnancyStatus String?
  lactationStage  String?
  photoUrl        String?
  notes           String?
  farmId          String
  farm            Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  vaccinations    Vaccination[]
  thermalReadings ThermalReading[]
  gestaChecks     GestaCheck[]
  muzzleProfiles  MuzzleProfile[]
  alerts          Alert[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Vaccination {
  id           String    @id @default(cuid())
  vaccineName  String
  doseDate     DateTime
  nextDueDate  DateTime?
  status       String    @default("SCHEDULED")
  vetName      String?
  batchNumber  String?
  notes        String?
  cattleId     String
  cattle       Cattle    @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cattleId])
  @@index([nextDueDate])
}

model InventoryItem {
  id           String   @id @default(cuid())
  name         String
  category     String
  quantity     Float    @default(0)
  unit         String   @default("units")
  reorderLevel Float    @default(0)
  supplier     String?
  farmId       String
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([farmId])
}

model Alert {
  id        String   @id @default(cuid())
  type      String
  severity  String   @default("LOW")
  title     String
  message   String
  isRead    Boolean  @default(false)
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cattleId  String?
  cattle    Cattle?  @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([farmId, isRead])
}

model ThermalReading {
  id          String   @id @default(cuid())
  temperatureC Float
  ambientC    Float?
  anomaly     Boolean  @default(false)
  riskLevel   String   @default("LOW")
  imageUrl    String?
  capturedAt  DateTime @default(now())
  cattleId    String
  cattle      Cattle   @relation(fields: [cattleId], references: [id], onDelete: Cascade)

  @@index([cattleId, capturedAt])
}

model GestaCheck {
  id                String   @id @default(cuid())
  method            String
  result            String
  confidence        Float?
  daysSinceBreeding Int?
  examDate          DateTime @default(now())
  notes             String?
  cattleId          String
  cattle            Cattle   @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([cattleId])
}

model MuzzleProfile {
  id        String   @id @default(cuid())
  imagePath String
  imageHash String   @unique
  cattleId  String
  cattle    Cattle   @relation(fields: [cattleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([cattleId])
}
